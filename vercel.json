{
  "buildCommand": "true",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/", "destination": "/juego/Reto-Saber.html" },
    { "source": "/demo/Reto-Saber-Demo.html", "destination": "/juego/Reto-Saber.html" }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/juego/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}
